sync_dir.mkdir(parents=True)

skip_names = {"github_sync", "__pycache__", ".git", ".ipynb_checkpoints", "chroma_db", "best_llm"}
skip_suffixes = {
    ".pt", ".pth", ".bin", ".safetensors", ".onnx",
    ".h5", ".keras", ".ckpt", ".faiss", ".chroma",
    ".db", ".sqlite", ".sqlite3", ".log", ".zip", ".tar", ".gz",
}

copied_items = []
for item in sorted(working_dir.iterdir()):
    if item.name in skip_names:
        continue
    if item.is_file() and item.suffix.lower() in skip_suffixes:
        continue
    if item.is_file() and item.stat().st_size > 50 * 1024 * 1024:
        continue
    if item.is_dir():
        shutil.copytree(item, sync_dir / item.name, ignore=shutil.ignore_patterns("__pycache__", "*.pyc", ".git"))
        copied_items.append(f"{item.name}/")
    else:
        shutil.copy2(item, sync_dir / item.name)
        copied_items.append(item.name)

