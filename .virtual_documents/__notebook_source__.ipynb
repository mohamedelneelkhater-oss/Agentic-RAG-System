def keyword_recall(answer, keywords):
    answer = answer.lower().replace("\u2019", "'")
    return sum(k.lower() in answer for k in keywords) / len(keywords)


def score_item(item, answer):
    refused = arag.is_refusal(answer)
    if item["answerable"]:
        return 0.0 if refused else keyword_recall(answer, item["keywords"])
    return 1.0 if refused else 0.0


